# Контекст сборки — корень репозитория (см. infra/pilot/compose.yaml).
# Сборка web-клиента и TLS-прокси пилотного контура в одном образе nginx.
FROM node:22-alpine AS build
WORKDIR /src
COPY packages/api_contracts packages/api_contracts
COPY apps/client/package.json apps/client/package-lock.json apps/client/
WORKDIR /src/apps/client
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY apps/client ./
# Клиент ходит в API по тому же адресу, по которому открыт: https://<хост>:<порт>.
ARG PUBLIC_ORIGIN
ENV EXPO_PUBLIC_API_URL=${PUBLIC_ORIGIN} \
    EXPO_NO_TELEMETRY=1
RUN test -n "$PUBLIC_ORIGIN" \
    && npm run gen:api \
    && npx expo export --platform web --output-dir dist-web

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY infra/pilot/nginx.conf /etc/nginx/conf.d/brigadir.conf
COPY infra/pilot/proxy.inc /etc/nginx/conf.d/proxy.inc
COPY --from=build /src/apps/client/dist-web /usr/share/nginx/html
EXPOSE 8443
