# Контекст сборки — корень репозитория. Воркер — тот же модульный монолит,
# другая точка входа.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv
COPY packages/forecast_core packages/forecast_core
COPY packages/synthetic_generator packages/synthetic_generator
COPY services/api services/api
COPY services/worker services/worker
RUN pip install ./packages/forecast_core ./packages/synthetic_generator ./services/api ./services/worker

RUN useradd --system --uid 10001 app
# Том журнала удалений пилота наследует владельца из образа (infra/pilot).
RUN mkdir -p /var/lib/brigadir/erasures && chown app /var/lib/brigadir/erasures
USER app

CMD ["python", "-m", "fb_worker"]
