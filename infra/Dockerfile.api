# Контекст сборки — корень репозитория (см. infra/compose.yaml).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv
COPY packages/forecast_core packages/forecast_core
COPY packages/synthetic_generator packages/synthetic_generator
COPY services/api services/api
RUN pip install ./packages/forecast_core ./packages/synthetic_generator ./services/api

RUN useradd --system --uid 10001 app
USER app
WORKDIR /srv/services/api
EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=3s --retries=20 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/ready').status == 200 else 1)"

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
