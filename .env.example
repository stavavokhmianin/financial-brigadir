# Скопируйте в .env. Секреты в репозиторий не коммитятся.

# --- Postgres (infra/compose.yaml) ---
POSTGRES_USER=brigadir
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=brigadir

# --- API ---
# Без переменной API использует локальный SQLite-файл (удобно без Docker).
DATABASE_URL=postgresql+psycopg://brigadir:change-me-locally@db:5432/brigadir
# Origin'ы клиента, которым разрешён CORS (Expo web по умолчанию на 8081).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Срок жизни демо-сессии, часов.
DEMO_SESSION_TTL_HOURS=24
LOG_LEVEL=INFO

# --- Клиент (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
